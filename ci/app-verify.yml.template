# アプリ案件の関門（2026-09-02 新設）。
#
# それまで Dart の3案件（aub-familywalk / flash-compose / planttalk）は
# **CI が無く**、submodule の道具20個のうち実際に走るのは1個だけだった。
# 関門は `design/verify.sh` を人が手で叩いたときだけで、push しても何も走らない。
#
# 手で走らせると落ちる状態だった（2026-09-02 実測）。
#   planttalk     : 実装網羅 10 / 26 件・未実装16件  exit 1
#   flash-compose : 実装網羅 21 / 29 件・未実装8件   exit 1
# 条件7 は「未実装が1件でもあれば落ちる」規則だが、**落ちる場所が無かった。**
#
# ## 段階導入
#
# いきなり関門にすると赤が続き、人が見なくなる。設定ファイルに `$warn_only` を
# 宣言した検査は**走らせるが CI は落とさない**（design-systems と同じ形）。
# 宣言・理由・外す条件は各案件の設定に書く（隠さない）。
#
# ## 機体
#
# CI は `HARNESS_MACHINE=CI` を名乗る。`design/machine-scope.json` の
# `machines` に `"CI": []` が要る（担当パス無し）。**無いと機体不明で
# exit 2 になり、CI が全部落ちる。**
name: verify

on:
  push:
    branches: [{{main または master}}]
  pull_request:

env:
  # CI は何も触らないので、design/ の担当機でしか意味がない段は理由つきで飛ぶ
  HARNESS_MACHINE: CI

jobs:
  harness:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          submodules: recursive   # 検査の道具は design/harness にある
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: ハーネスの検査
        run: |
          set -u
          H=design/harness/tools
          FAILED=0
          RAN=0
          SKIPPED=0

          # 設定の置き場は案件ごとに違う（root か design/ か）。**黙って飛ばさない。**
          pick() { for f in "$@"; do [ -f "$f" ] && { echo "$f"; return 0; }; done; return 1; }

          run() {   # run <名前> <設定ファイル or -> <コマンド…>
            local label="$1"; local conf="$2"; shift 2
            echo "=== $label ==="
            RAN=$((RAN + 1))
            if "$@"; then return 0; fi
            if [ "$conf" != "-" ] && [ -f "$conf" ] && grep -q '"\$warn_only"' "$conf"; then
              echo "  ↑ 「知らせるだけ」の宣言があるため CI は落としません（$conf）"
              return 0
            fi
            FAILED=1
          }

          skip() {  # skip <名前> <理由>
            echo "=== $1 ==="
            echo "  飛ばしました: $2"
            SKIPPED=$((SKIPPED + 1))
          }

          run "禁止パターン（全量）"          - python3 design/design_check.py --all
          run "文脈（共通の憲法の参照）"      - python3 $H/design_md_check.py
          run "生成器の入力"                  - python3 $H/gen_input_check.py
          run "種まき（ルールが生きているか）" - python3 $H/seed_check.py
          run "段の健全性"                    - python3 $H/stage_check.py --verify design/verify.sh

          if C=$(pick design/impl-coverage.json impl-coverage.json); then
            run "実装網羅（条件7）" "$C" python3 $H/impl_coverage_check.py --config "$C"
          else
            skip "実装網羅（条件7）" "impl-coverage.json がありません。**条件7 が誰も見ていません**"
          fi

          if C=$(pick design/figma/page-scope.json); then
            run "ページの範囲" "$C" python3 $H/page_scope_check.py --config "$C"
          else
            skip "ページの範囲" "page-scope.json がありません。参照してよいページの宣言が無い状態です"
          fi

          if C=$(pick design/machine-scope.json); then
            run "機体の担当" "$C" python3 $H/machine_scope.py --config "$C" --check
          else
            skip "機体の担当" "machine-scope.json がありません"
          fi

          if C=$(pick design/gaps.json); then
            run "見なかったもの" "$C" python3 $H/gap_report.py --config "$C"
          else
            skip "見なかったもの" "gaps.json がありません。**限界が AI の自己申告のままです**"
          fi

          echo
          echo "走らせた段: $RAN / 飛ばした段: $SKIPPED"
          if [ "$RAN" -eq 0 ]; then
            echo "段を1つも走らせていません。**通ったのではなく、何も見ていません。**" >&2
            exit 1
          fi
          if [ "$SKIPPED" -gt 0 ]; then
            echo "**飛ばした段があります。** 設定を足すと関門が増えます（上の理由を参照）"
          fi
          exit $FAILED

      # 生成物のべき等は Python だけで回る（Flutter を入れずに済む）
      - name: 生成物のべき等
        if: hashFiles('design/gen/verify.py') != ''
        run: python3 design/gen/verify.py

  # 静的解析とテストは案件ごとに前提が違う（同梱 DB・フォント等）ので、
  # **この雛形には入れない。** 必要な案件が自分で job を足す
