#!/usr/bin/env bash
# 統合検査の入口（テンプレート・2026-08-29 新設）。
#
# <プロジェクト>/design/verify.sh として置き、{{ }} を具体化する。
# **必須段はこの並びから減らさない。** aub-familywalk で impl_coverage が
# 未配線だったために、31部品中9部品の状態で「照合の穴 0」と報告された実害がある。
# 規則や道具があっても、ここに1行足されていなければ素通りする。
#
# 使い方:
#   bash design/verify.sh          全部
#   bash design/verify.sh quick    禁止パターンだけ（保存時の hook と同じ検査を全量で）
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1     # リポジトリのルートへ

HARNESS="design/harness"
PY="${PYTHON:-python3}"
export PYTHONUTF8=1 PYTHONIOENCODING=utf-8
FAILED=0

step() {  # step <名前> <コマンド...>
  echo "=== $1 ==="
  shift
  if "$@"; then echo "OK"; else echo "NG"; FAILED=1; fi
  echo
}

if ! command -v "$PY" >/dev/null 2>&1; then
  echo "python3 が見つかりません。検査を実行できないため中止します。" >&2
  exit 1
fi
if [ ! -f "$HARNESS/engine/design_check.py" ]; then
  echo "検査エンジンがありません（$HARNESS）。" >&2
  echo "  git submodule update --init --recursive" >&2
  exit 1
fi

TARGET="${1:-all}"

# --- 必須段（減らさない）----------------------------------------------------
step "禁止パターン（全量・条件1）"   "$PY" design/design_check.py --all
# ルールの鎖が CI でも解決できるか。**手元でだけ通る構成**を先に落とす
# （FlashEnglish 2026-09-03: extends が3つともリポジトリ外を指しており、
#  手元 70 ファイル・11 ルール、CI は走査 0 ファイル。入れた日から一度も緑が無かった）
step "ルールの鎖（extends が CI から解決できるか）" \
  "$PY" "$HARNESS/tools/ci_path_check.py" --rules design/rules.json
[ "$TARGET" = "quick" ] && exit $FAILED

step "文脈（共通の憲法を参照しているか・写していないか）" \
  "$PY" "$HARNESS/tools/design_md_check.py"

step "実装網羅（条件7: Figma にあるものは全部実装）" \
  "$PY" "$HARNESS/tools/impl_coverage_check.py" --config impl-coverage.json
step "照合体制（参考: 条件2 は 2026-09-03 に廃止。検査としては有用）" \
  "$PY" "$HARNESS/tools/coverage_check.py" --config coverage.json
step "生成器の入力（書き出し以外を読んでいないか）" \
  "$PY" "$HARNESS/tools/gen_input_check.py"
step "鮮度差（書き出し → 生成物・記録）" \
  "$PY" "$HARNESS/tools/staleness_check.py" --config staleness.json
step "ページの範囲（参照してよいページか）" \
  "$PY" "$HARNESS/tools/page_scope_check.py" --config design/figma/page-scope.json
step "再現性の判定（条件5: 値が合っても描画で別物になる指定）" \
  "$PY" "$HARNESS/tools/check_render_gaps.py" --config {{<DS>/render-gaps.json}}
step "種まき（条件8: ルールが実際に発火するか）" \
  "$PY" "$HARNESS/tools/seed_check.py"
step "ルールの生成物（条件8: 段の値が tokens と一致するか）" \
  "$PY" "$HARNESS/tools/gen_rules.py" --config {{<DS>/rules/gen-rules.json}} --check

# Figma 本体との鮮度。**design/ を触る機体でだけ必須**（2026-08-30 に結び直した）。
#
# それまで全マシンで FIGMA_TOKEN を要求し、無ければ落としていた。しかし
# この段が守るのは「Figma を変えたのに書き出しを取り直していない」状態で、
# それを起こせるのは design/ を触る機体だけ。Windows（トークンが無い）と
# Mac mini（403）は、**自分には起こせない失敗のために**止まっていた。
#
# **段は減らさない。責任のある機体に結び直す。** 担当外の機体では、機体名と
# 理由を出力に残して飛ばす（黙って飛ばさない）。飛ばした穴は、次の
# 「機体の担当」の段が塞ぐ——担当外のパスを変えていたらそこで落ちる。
#
# **この形（`--owns … -- <コマンド>`）を使う。`--test-owns` を素で呼ばない。**
# `--test-owns` は担当外で **3** を返すので、`set -euo pipefail` の下では
# `case $?` に着く前にスクリプトごと死ぬ。`exit 3` はこのファイルに1行も
# 書かれていないので、grep しても見つからない。
#
#   実害（FlashEnglish・2026-09-03）: Mac mini と Windows が **2日間、
#   この verify.sh の検査を一度も走らせていなかった。** 両機とも --no-verify で
#   push していた（決まりに反する状態）。
#
# どうしても真偽で分岐したいときは、`if` か `|| rc=$?` で受ける:
#
#   if "$PY" "$HARNESS/tools/machine_scope.py" --test-owns design/; then …; fi
#
#   rc=0
#   "$PY" "$HARNESS/tools/machine_scope.py" --test-owns design/ || rc=$?
#   case $rc in 0) … ;; 3) : ;; *) exit 1 ;; esac
step "鮮度（条件4: Figma 本体 → 書き出し。design/ の担当機のみ）" \
  "$PY" "$HARNESS/tools/machine_scope.py" --config design/machine-scope.json \
    --owns design/ -- bash -c '
      if [ -z "${FIGMA_TOKEN:-}" ]; then
        echo "FIGMA_TOKEN がありません。鮮度を確認せずに通すことはしません。" >&2
        echo "  source ~/.claude/.env を実行してから再実行してください。" >&2
        exit 1
      fi
      '"$PY"' design/figma_freshness.py'

# 上で飛ばした穴を塞ぐ対の検査。担当外と宣言した機体が担当外のパスを
# 変えていたら落とす（Windows が design/ を触っていたら、ここで止まる）
# **自分の機体だけ緑**を止める（衝突で CI が起動しない／レジストリが枝に居る／
# 受信箱が枝に取り残される）。ネットワークも認証も要らない
step "共有されているか（衝突・レジストリ・受信箱）" \
  "$PY" "$HARNESS/tools/shared_check.py" --conflict \
    --shared design/machine-scope.json --registry "$HOME/dev/design-systems"
# **複数ファイル・複数担当に散る1つの値**（表示名など）。
# FlashEnglish では3通りが2日以上混在し、誰も気づかなかった
# **決定の取り消し**。追記式の記録は、前の決定が生きているように読める
# （aub 2026-09-03: 1日で2回ひっくり返り、実装コメントが取り消し済みの文言を
#  引用したまま残った。次に読む AI は矛盾した2つの正を見る）
step "決定の取り消し（取り消し済みを実装が引用していないか）" \
  "$PY" "$HARNESS/tools/decisions_check.py" --decisions DECISIONS.md --impl lib
step "散らばった値（表示名など）" \
  "$PY" "$HARNESS/tools/platform_values_check.py" --config design/platform-values.json
step "機体の担当（担当外のパスを変えていないか）" \
  "$PY" "$HARNESS/tools/machine_scope.py" --config design/machine-scope.json --check

# **Windows でだけ落ちる書き方**を Mac / Linux から見つける。検査そのものが
# macOS でしか回っていなかったため、aub では3日で5件出た（うち2件は検査自身）。
# --style は読むだけで速い。--encoding は cp932 で全道具を回すので遅い。
step "移植性（Windows でだけ落ちる書き方）" \
  "$PY" "$HARNESS/tools/portable_check.py" --root "$HARNESS/tools" --style

# 見なかったものを機械が出す。完了レポートの「残っている限界」はこの出力を貼る
# （AI の自己申告にしない。走査が空振りしていれば exit 2 で落ちる）
step "期待値の出どころ（照合テストが書き出しを読んでいるか）" \
  "$PY" "$HARNESS/tools/expectation_source_check.py" --config design/expectations.json
# 画面の書き出しが**足りている**か（記録層を消せる前提条件）。
# 「在る」と「足りている」は違う（FlashEnglish の frames.json は3件で、
#  中身は部品にならない枠。画面のノード木ではなかった）
# 書き出しが**読まなかったプロパティ**を宣言しているか。
# 「Figma に無い」と「器が拾っていない」が区別できないと、AI は前者だと思って
# 推測で埋める（FlashEnglish の誤読7件のうち3件がこの根）
step "読めていないプロパティの宣言" \
  "$PY" "$HARNESS/tools/gen_notcaptured.py" --config design/notcaptured.json --check
# 実装の中だけの数値（**Figma を直しても動かない値**）。
# 記録層を消しても、手で測った値は実装の定数へ移るだけ
# （aub: 82.4 で 440 の機体が 50px ずれ / 254 で余白が 20→45 / 138.0 は「Figma の実測」）
# **書き出しの中だけで見つかる矛盾**を、実装の前に出す
# （aub: 子が親の中身より広い3件が、全部実機とユーザーの指摘で戻った）
# **画面をまたぐ矛盾**（1画面ずつの検査では原理的に拾えない層）。
# aub 2026-08-30: 4つの行き先が定義だけあって、どこからも呼ばれていなかった。
# 「スプラッシュ → PROGRESS で行き止まり」を実機の通し確認まで誰も気づかなかった
step "行き先の到達（どこからも行けない画面が無いか）" \
  "$PY" "$HARNESS/tools/route_check.py" --lib lib
step "書き出しの検算（子が親からはみ出していないか）" \
  "$PY" "$HARNESS/tools/export_sanity_check.py" --frames design/figma/frames.json
step "実装の中だけの数値" \
  "$PY" "$HARNESS/tools/impl_value_check.py" --config design/impl-values.json
step "画面の書き出し（記録層を消せる前提）" \
  "$PY" "$HARNESS/tools/screen_export_check.py" --config design/screens-check.json
# 器が figma.mixed を素で読んでいないか（**書き出しごと止まる**。
# qnd 2026-09-03: 辺ごとに違う線の太さで12部品のうち1件も取れなかった）
# 見本の変異が子を隠していないか（#22: アイコンの寸法がどこにも無かった）
# {{書き出しのパス}} はレジストリ参照の案件ではレジストリ側を指す
step "見本の変異（子を隠していないか）" \
  "$PY" "$HARNESS/tools/exporter_check.py" --samples design/figma/components.json
step "器の書き方（figma.mixed で止まらないか）" \
  "$PY" "$HARNESS/tools/exporter_check.py" --style --config design/exporters.json
step "書き出しの器（保存されていて指紋が一致するか）" \
  "$PY" "$HARNESS/tools/exporter_check.py" --config design/exporters.json
# **押した状態が試験で一度も描かれない**（tap は down と up の間に
# フレームを挟まない）＋ **Figma に無い組み合わせへ実装が動きうる**。
# aub: 試験816件が緑のまま、リリース版で画面が消えた
# **アプリアイコン**（どの関門からも見られていなかった）。
# FlashEnglish 2026-08-27: 書き出しが黙って壊れ、20枚中14枚が別物のまま
# 「成功」で終わった。2026-09-04: Android の前景が全幅に広がり左右が切れていた
step "アプリアイコン（宣言どおりに揃っているか）" \
  "$PY" "$HARNESS/tools/appicon_check.py" \
    --ios ios/Runner/Assets.xcassets/AppIcon.appiconset \
    --android android/app/src/main/res
# **実装の中の重複**（部品を直しても手組みの画面には届かない）。
# 既存の段は分母がどれも Figma 側で、実装側から見た重複を数えるものが無かった
step "実装の中の重複（同じ絵を2か所で組んでいないか）" \
  "$PY" "$HARNESS/tools/impl_duplication_check.py" --config design/impl-duplication.json
step "押した状態と変異の穴" \
  "$PY" "$HARNESS/tools/interaction_check.py" --config design/interaction.json
step "条件9 の網羅（状態・スロットを持つセットにテストがあるか）" \
  "$PY" "$HARNESS/tools/tree_test_check.py" --config design/tree-tests.json
step "指紋の一致（JS と Python で同じ値になるか）" \
  "$PY" "$HARNESS/tools/fingerprint_parity.py"
# **検査が回っているのに何も見ていない書き方**を見る（aub 2026-09-02〜03 で
# 2日に5件。全部緑で、うち3件は実機とユーザーが見つけた）。
# 例外を捨てる / 期待値の自己参照 / 緩い finder / 誰も見ていない文字
step "空振りの検査（何も見ていない書き方）" \
  "$PY" "$HARNESS/tools/hollow_check.py" --config design/hollow.json
step "段の健全性（落ちるところを見た道具か）" \
  "$PY" "$HARNESS/tools/stage_check.py" --verify design/verify.sh
# **段の数**を見る。元ファイルにある段がこの案件から落ちていないか。
# 意図して当てはまらない段は design/stages.json に理由つきで宣言する
# （FlashEnglish 2026-09-02: 元ファイルの18段のうち7段がどこにも無く、
#  「意図して不在」と「黙って落ちた」が区別できなかった）
step "段の数（元ファイルの段が落ちていないか・関門の条件が全部測られているか）" \
  "$PY" "$HARNESS/tools/stage_check.py" --stages --verify design/verify.sh
step "見なかったもの（条件8: gap_report）" \
  "$PY" "$HARNESS/tools/gap_report.py" --config design/gaps.json

# --- 案件固有の段（{{ }} を具体化して足す）----------------------------------
# step "静的解析"        {{flutter analyze / npx tsc --noEmit}}
step "生成物のべき等（生成し直して差分が出ないか）" \
  "$PY" "$HARNESS/tools/gen_verify.py"
# step "テスト"          {{flutter test / npm test}}

if [ "$FAILED" -ne 0 ]; then
  echo "検証に失敗しました。上の NG を直してから再実行してください。"
  exit 1
fi
echo "すべての検証を通過しました。"
