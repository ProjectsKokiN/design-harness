#!/bin/sh
# アプリ案件向けの pre-push 雛形（aub-familywalk の実運用から 2026-08-28 に回収）。
#
# 導入:
#   cp design/harness/ci/app-pre-push .githooks/pre-push
#   chmod +x .githooks/pre-push
#   git config core.hooksPath .githooks
#
# production-gate: 「CI が無い段階の案件は、pre-push から verify.sh を呼ぶ」。
# GitHub Actions を持つ案件は ci/ の workflow を使い、これは補助にする。

set -u

# **stdin は一度しか読めない。** 先に全部受ける（2026-09-04・#61）。
# 押された枝の一覧はここにしか来ないので、1つの読み手が食べると
# 次の判定が空を見る。雛形はここを踏みやすい
REFS=$(cat)

# 1) main への直 push は止めない（2026-09-05 ユーザー確定で廃止）
#
# 原文: 「macからメインへ直接プッシュしないというルールが枷になっている感じがするので、
# 解除してもいいかなと思いました」「PRを私が見返すこと自体はないんですよね」。
#
# **どのマシンからも `git push origin main` でよい。** 残っていた利点は PR の記録だけで、
# それを見返す運用が無かった。一方で実害が出ていた——受信箱（MACHINE_TASKS.md）は
# 既定ブランチにしか置けないため、Mac が受信箱に書けなかった（aub 2026-09-05）。
#
# 検査は下の verify.sh と、main への push で走る CI が同じものを回す。
# **`--no-verify` は引き続き禁止**（禁止の理由は中身を検査せずに送れてしまうこと）。
# 復活させるときの置き場は ~/.claude/memory/feedback_mac_no_main_push_hook.md。

# 2) 枝の削除だけなら検査を飛ばす（2026-09-04・#61）
#
# 削除は local_sha が全部ゼロの行として来る。**送る中身が1バイトもありません。**
# 実害: FlashEnglish でマージ済みの枝6本を消そうとして 10 分で時間切れになり、
# 3本が消えないまま残った。残った枝は、あとから読んだ AI が
# 「まだ作業中のものがある」と誤読する種になる。
#
# `--no-verify` は答えにならない。禁止の理由は「中身を検査せずに送れてしまう」で、
# **送る中身が無い削除はそもそもその理由に当たらない**。運用で緩めると、
# 緩めた口から中身のある push が通る。**1行でも削除以外があれば検査する。**
ALLDEL=1
ANYREF=0
while read -r _lr lsha _rr _rsha; do
  [ -z "${lsha:-}" ] && continue
  ANYREF=1
  case "$lsha" in
    *[!0]*) ALLDEL=0 ;;
  esac
done <<REFS_EOF
$REFS
REFS_EOF

if [ "$ANYREF" = 1 ] && [ "$ALLDEL" = 1 ]; then
  echo "枝の削除だけなので検査を飛ばします（送る中身が1バイトもありません）。"
  exit 0
fi

# 3) 統合検査（無い場合はその旨を言って落とす。黙って通さない）
# --- 押す中身と、検査した中身が同じか ----------------------------------------
#
# **`verify.sh` は作業ツリーを見ます。押されるのはコミットの中身です。**
# ここが違うと、**直していないものを緑のまま押せます。**
#
# 実害（2026-09-10・MacBook Air）: `git add` を忘れ、`git commit` が
# **submodule のポインタだけ**を拾った。作業ツリーには直しが在るので
# `verify.sh` は rc=0。押されたのはポインタだけで、
# **`build_manifest.py` の直しも新しい段も入っていなかった。**
# **両案件で同じことを同時にやり**、Windows が「`as_posix` の出現 0 件・
# 段が両案件に無い」と数えて初めて分かった。**2往復ぶん無駄にした。**
#
# **追跡ファイルに未コミットの変更があれば止めます。** 追跡外（生成物・ビルド）は
# 見ません。**わざと残すなら `git stash` か、宣言して commit してください。**
DIRTY="$(git diff --name-only HEAD -- . 2>/dev/null)"
if [ -n "$DIRTY" ]; then
  echo "**押す中身と、検査した中身が違います。**" >&2
  echo "$DIRTY" | sed 's/^/  /' >&2
  echo "  上のファイルに**未コミットの変更**があります。" >&2
  echo "  `verify.sh` は作業ツリーを見るので**緑になりますが、押されるのはコミットの中身**です。" >&2
  echo "  **直しがコミットに入っていない状態で押すと、直っていないものが押されます**" >&2
  echo "  （2026-09-10 に実際に2案件で起きました）。" >&2
  echo "  git add してからコミットするか、git stash で外してください。" >&2
  exit 1
fi

if [ -x design/verify.sh ] || [ -f design/verify.sh ]; then
  sh design/verify.sh || exit 1
else
  echo "design/verify.sh がありません。検査せずに push はしません。" >&2
  exit 1
fi

# 4) ピンの遅れ（2026-09-04・#60）
#
# **`2>/dev/null || true` で呼んでいた。** 出力を捨てて必ず成功する形で、
# FlashEnglish のピンが枝の途中で 16 コミット遅れたまま誰も気づかなかった。
# 落とすのは「ピンが既定ブランチに入っていない」ときだけ（直しようのない状態）。
# 遅れそのものは知らせるだけで、上げる判断は人がする。
if [ -f design/harness/tools/pin_check.py ]; then
  python3 design/harness/tools/pin_check.py --root . || exit 1
else
  echo "pin_check.py がありません（submodule 未取得?）。ピンは**未確認**です。" >&2
fi
